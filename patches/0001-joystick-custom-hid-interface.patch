diff --git a/tmk_core/protocol.mk b/tmk_core/protocol.mk
index 81520c1b..2d84a5d8 100644
--- a/tmk_core/protocol.mk
+++ b/tmk_core/protocol.mk
@@ -65,9 +65,13 @@ endif
 
 ifeq ($(strip $(JOYSTICK_ENABLE)), yes)
     OPT_DEFS += -DJOYSTICK_ENABLE
-    ifeq ($(strip $(SHARED_EP_ENABLE)), yes)
-        OPT_DEFS += -DJOYSTICK_SHARED_EP
-        SHARED_EP_ENABLE = yes
+    # JOYSTICK_OWN_EP = yes keeps the joystick on its own interface and endpoint, with
+    # no report ID, even when other reports share an endpoint.
+    ifneq ($(strip $(JOYSTICK_OWN_EP)), yes)
+        ifeq ($(strip $(SHARED_EP_ENABLE)), yes)
+            OPT_DEFS += -DJOYSTICK_SHARED_EP
+            SHARED_EP_ENABLE = yes
+        endif
     endif
 endif
 
diff --git a/tmk_core/protocol/chibios/usb_main.c b/tmk_core/protocol/chibios/usb_main.c
index 5939e327..43e79663 100644
--- a/tmk_core/protocol/chibios/usb_main.c
+++ b/tmk_core/protocol/chibios/usb_main.c
@@ -233,6 +233,51 @@ static void usb_event_cb(USBDriver *usbp, usbevent_t event) {
 
 static uint8_t _Alignas(4) set_report_buf[2];
 
+#if defined(JOYSTICK_ENABLE) && defined(JOYSTICK_REPORT_DESCRIPTOR)
+// Output and feature reports the host sends the custom joystick interface with
+// SET_REPORT. The callback runs in the USB interrupt, so it only records the report;
+// the keymap reads it from the main loop with joystick_receive_report(). A feature
+// report read back (GET_REPORT) returns the last one the host set, zeros at first,
+// or what the keymap set since with joystick_set_feature_reply().
+static uint8_t _Alignas(4) joystick_set_report_buf[JOYSTICK_HOST_REPORT_SIZE];
+static uint8_t _Alignas(4) joystick_feature_buf[JOYSTICK_HOST_REPORT_SIZE];
+static volatile uint8_t    joystick_set_report_length;
+static volatile uint8_t    joystick_set_report_type;
+
+static void joystick_set_report_cb(USBDriver *usbp) {
+    usb_control_request_t *setup = (usb_control_request_t *)usbp->setup;
+    uint8_t                length = setup->wLength < JOYSTICK_HOST_REPORT_SIZE ? setup->wLength : JOYSTICK_HOST_REPORT_SIZE;
+    if (setup->wValue.hbyte == 3) {
+        memcpy(joystick_feature_buf, joystick_set_report_buf, length);
+    }
+    joystick_set_report_type   = setup->wValue.hbyte;
+    joystick_set_report_length = length;
+}
+
+void joystick_set_feature_reply(const uint8_t *data, uint8_t length) {
+    if (length > JOYSTICK_HOST_REPORT_SIZE) {
+        length = JOYSTICK_HOST_REPORT_SIZE;
+    }
+    chSysLock();
+    memset(joystick_feature_buf, 0, sizeof(joystick_feature_buf));
+    memcpy(joystick_feature_buf, data, length);
+    chSysUnlock();
+}
+
+uint8_t joystick_receive_report(uint8_t *data, uint8_t size, uint8_t *type) {
+    chSysLock();
+    uint8_t length = joystick_set_report_length;
+    if (length > size) {
+        length = size;
+    }
+    memcpy(data, joystick_set_report_buf, length);
+    *type                      = joystick_set_report_type;
+    joystick_set_report_length = 0;
+    chSysUnlock();
+    return length;
+}
+#endif
+
 static void set_led_transfer_cb(USBDriver *usbp) {
     usb_control_request_t *setup = (usb_control_request_t *)usbp->setup;
 
@@ -255,6 +300,12 @@ static bool usb_requests_hook_cb(USBDriver *usbp) {
             case USB_RTYPE_DIR_DEV2HOST:
                 switch (setup->bRequest) {
                     case HID_REQ_GetReport:
+#if defined(JOYSTICK_ENABLE) && defined(JOYSTICK_REPORT_DESCRIPTOR) && defined(JOYSTICK_FEATURE_REPORT_SIZE)
+                        if (setup->wIndex == JOYSTICK_INTERFACE && setup->wValue.hbyte == 3) {
+                            usbSetupTransfer(usbp, joystick_feature_buf, setup->wLength < JOYSTICK_FEATURE_REPORT_SIZE ? setup->wLength : JOYSTICK_FEATURE_REPORT_SIZE, NULL);
+                            return true;
+                        }
+#endif
                         return usb_get_report_cb(usbp);
                     case HID_REQ_GetProtocol:
                         if (setup->wIndex == KEYBOARD_INTERFACE) {
@@ -279,6 +330,11 @@ static bool usb_requests_hook_cb(USBDriver *usbp) {
 #endif
                                 usbSetupTransfer(usbp, set_report_buf, sizeof(set_report_buf), set_led_transfer_cb);
                                 return true;
+#if defined(JOYSTICK_ENABLE) && defined(JOYSTICK_REPORT_DESCRIPTOR)
+                            case JOYSTICK_INTERFACE:
+                                usbSetupTransfer(usbp, joystick_set_report_buf, setup->wLength < JOYSTICK_HOST_REPORT_SIZE ? setup->wLength : JOYSTICK_HOST_REPORT_SIZE, joystick_set_report_cb);
+                                return true;
+#endif
                         }
                         break;
                     case HID_REQ_SetProtocol:
