diff --git a/tmk_core/protocol/usb_descriptor.h b/tmk_core/protocol/usb_descriptor.h
index 27058b7c..f68310cd 100644
--- a/tmk_core/protocol/usb_descriptor.h
+++ b/tmk_core/protocol/usb_descriptor.h
@@ -307,7 +307,25 @@ enum usb_endpoints {
 #define MIDI_STREAM_EPSIZE 64
 #define CDC_NOTIFICATION_EPSIZE 8
 #define CDC_EPSIZE 16
-#define JOYSTICK_EPSIZE 8
+// A keymap may set JOYSTICK_EPSIZE and JOYSTICK_POLLING_INTERVAL and supply
+// JOYSTICK_REPORT_DESCRIPTOR to present a specific device on the joystick's own
+// interface; QMK_JOYSTICK_CUSTOM marks support for these and for passing its output
+// and feature reports to the keymap (joystick_receive_report) and answering feature
+// reads (joystick_set_feature_reply).
+#define QMK_JOYSTICK_CUSTOM 1
+#ifndef JOYSTICK_EPSIZE
+#    define JOYSTICK_EPSIZE 8
+#endif
+#ifndef JOYSTICK_POLLING_INTERVAL
+#    define JOYSTICK_POLLING_INTERVAL USB_POLLING_INTERVAL_MS
+#endif
+// The largest output or feature report the host may set; JOYSTICK_FEATURE_REPORT_SIZE,
+// if set, is the size of the feature report it reads back.
+#ifndef JOYSTICK_HOST_REPORT_SIZE
+#    define JOYSTICK_HOST_REPORT_SIZE 64
+#endif
+uint8_t joystick_receive_report(uint8_t *data, uint8_t size, uint8_t *type);
+void    joystick_set_feature_reply(const uint8_t *data, uint8_t length);
 #define DIGITIZER_EPSIZE 8
 
 uint16_t get_usb_descriptor(const uint16_t wValue, const uint16_t wIndex, const uint16_t wLength, const void** const DescriptorAddress);
